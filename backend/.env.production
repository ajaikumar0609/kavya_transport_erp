AWS_S3_BUCKET=kavya-transports-files
AWS_REGION=ap-south-1

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/etc/kavya/firebase-service-account.json

