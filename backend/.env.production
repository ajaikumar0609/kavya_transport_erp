# =============================================================================
# backend/.env.production — Kavya Transports ERP
# Copy to: /etc/kavya/.env on the EC2 server, chmod 600, owned by deploy user.
# NEVER commit this file to git.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Kavya Transports ERP
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=d156670b0475e2cf04f97bc2318618e22b377c224d64f1494336db14a35fdab6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# DB runs on same EC2 instance — localhost is correct here
POSTGRES_HOST=database-1.cja60iaay252.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Kavyatransport2004
POSTGRES_DB=postgres

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://techkavyatransports_db:Kavyatransport2004@cluster0.edccpzz.mongodb.net/?appName=Cluster0
MONGO_URL=mongodb+srv://techkavyatransports_db:Kavyatransport2004@cluster0.edccpzz.mongodb.net/?appName=Cluster0
MONGODB_DB=kavya_otp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Public-facing URLs ────────────────────────────────────────────────────────
FRONTEND_URL=https://kavyatransports.com
BACKEND_URL=https://api.kavyatransports.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.kavyatransports.com","https://kavyatransports.com","https://www.kavyatransports.com"]

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
STORAGE_TYPE=s3
STORAGE_BUCKET=kavya-transport-docs
AWS_ACCESS_KEY_ID=AKIAXTHSBAWWRXVSVLGA
