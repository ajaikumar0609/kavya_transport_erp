# ─── IFIAS — Invoice Automation ───────────────────────────────────────────────

# IMAP (direct mailbox access — preferred, faster)
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993
IMAP_EMAIL=info@KavYaTransports.com
IMAP_PASSWORD=suma
IMAP_SEARCH_FOLDERS=INBOX,Sent Items

# Outlook Web browser fallback (Playwright headless)
OUTLOOK_EMAIL=info@KavYaTransports.com
OUTLOOK_PASSWORD=suma
OUTLOOK_WEB_URL=https://outlook.office.com

# OneDrive billing Excel watch path
ONEDRIVE_WATCH_PATH=C:/Users/YogeC/OneDrive - Kavya Transports/Kavya transports
ONEDRIVE_WATCH_PATTERN=Invoice Reference

# Confidence thresholds (0–1)
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_REVIEW_THRESHOLD=0.60

# Hugging Face Inference API (Donut DocVQA)
HF_API_KEY=YOUR_HF_API_KEY_HERE
HF_MODEL_ID=naver-clova-ix/donut-base-finetuned-docvqa

# Local OCR engines disabled — use API-based extraction
USE_LOCAL_DONUT=false
USE_LOCAL_TESSERACT=false
